<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AUTH1_COMPANY_definitions" targetNamespace="https://vero.prototype/processes/v1" exporter="VERO prototype" exporterVersion="1.22.0">
  <bpmn:process id="AUTH1_COMPANY" name="Подключение организации через УКЭП" isExecutable="false">
    <bpmn:documentation>Подключить организацию и получить подтверждённые полномочия генерального директора. Предлагаемый процесс по текущему прототипу; не исполняемый серверный процесс.</bpmn:documentation>
    <bpmn:laneSet id="AUTH1_COMPANY_lanes">
      <bpmn:lane id="AUTH1_COMPANY_lane_0" name="Пользователь / руководитель">
        <bpmn:flowNodeRef>AUTH1_COMPANY_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_no_access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AUTH1_COMPANY_lane_1" name="Платформа ВЕРО">
        <bpmn:flowNodeRef>AUTH1_COMPANY_certificate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_COMPANY_approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AUTH1_COMPANY_start" name="Аккаунт создан; подключить организацию">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:outgoing>AUTH1_COMPANY_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AUTH1_COMPANY_select" name="Выбрать сертификат УКЭП">
      <bpmn:documentation>Участник: Генеральный директор</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_0</bpmn:incoming>
      <bpmn:incoming>AUTH1_COMPANY_flow_4</bpmn:incoming>
      <bpmn:incoming>AUTH1_COMPANY_flow_11</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_COMPANY_certificate" name="Сертификат действующий и принадлежит гендиректору?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_1</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_2</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_COMPANY_flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_COMPANY_invalid" name="Показать причину; доступ не предоставлять">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_3</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_COMPANY_review" name="Проверить сведения; дополнить контакты и недостающие поля">
      <bpmn:documentation>Участник: Генеральный директор</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_2</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_COMPANY_confirm" name="Подтвердить данные и контакты">
      <bpmn:documentation>Участник: Генеральный директор</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_5</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_COMPANY_send" name="Принять данные на проверку">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_6</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_COMPANY_decision" name="Проверка пройдена?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_7</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_8</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_COMPANY_flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_COMPANY_reject" name="Сообщить причину отказа; права не выдавать">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_9</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_COMPANY_again" name="Выбрать другой сертификат?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Генеральный директор</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_10</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_11</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_COMPANY_flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="AUTH1_COMPANY_no_access" name="Организация не подключена">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="AUTH1_COMPANY_approve" name="Подключить организацию и сохранить роль руководителя">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_8</bpmn:incoming>
      <bpmn:outgoing>AUTH1_COMPANY_flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_COMPANY_done" name="Организация подключена; регистрация завершена">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_COMPANY_flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_0" sourceRef="AUTH1_COMPANY_start" targetRef="AUTH1_COMPANY_select" name="" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_1" sourceRef="AUTH1_COMPANY_select" targetRef="AUTH1_COMPANY_certificate" name="" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_2" sourceRef="AUTH1_COMPANY_certificate" targetRef="AUTH1_COMPANY_review" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_3" sourceRef="AUTH1_COMPANY_certificate" targetRef="AUTH1_COMPANY_invalid" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_4" sourceRef="AUTH1_COMPANY_invalid" targetRef="AUTH1_COMPANY_select" name="Другой сертификат" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_5" sourceRef="AUTH1_COMPANY_review" targetRef="AUTH1_COMPANY_confirm" name="" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_6" sourceRef="AUTH1_COMPANY_confirm" targetRef="AUTH1_COMPANY_send" name="" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_7" sourceRef="AUTH1_COMPANY_send" targetRef="AUTH1_COMPANY_decision" name="" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_8" sourceRef="AUTH1_COMPANY_decision" targetRef="AUTH1_COMPANY_approve" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_9" sourceRef="AUTH1_COMPANY_decision" targetRef="AUTH1_COMPANY_reject" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_10" sourceRef="AUTH1_COMPANY_reject" targetRef="AUTH1_COMPANY_again" name="" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_11" sourceRef="AUTH1_COMPANY_again" targetRef="AUTH1_COMPANY_select" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_12" sourceRef="AUTH1_COMPANY_again" targetRef="AUTH1_COMPANY_no_access" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_COMPANY_flow_13" sourceRef="AUTH1_COMPANY_approve" targetRef="AUTH1_COMPANY_done" name="" />
  </bpmn:process>
  <bpmn:collaboration id="AUTH1_COMPANY_collaboration">
    <bpmn:participant id="AUTH1_COMPANY_pool" name="Подключение организации через УКЭП" processRef="AUTH1_COMPANY" />
  </bpmn:collaboration>
