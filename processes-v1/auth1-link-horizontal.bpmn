<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AUTH1_LINK_definitions" targetNamespace="https://vero.prototype/processes/v1" exporter="VERO prototype" exporterVersion="1.23.0">
  <bpmn:process id="AUTH1_LINK" name="Необязательная привязка mos.ru" isExecutable="false">
    <bpmn:documentation>Добавить вход через mos.ru к существующему аккаунту без создания дубля. Предлагаемый процесс по текущему прототипу; не исполняемый серверный процесс.</bpmn:documentation>
    <bpmn:laneSet id="AUTH1_LINK_lanes">
      <bpmn:lane id="AUTH1_LINK_lane_0" name="Пользователь / руководитель">
        <bpmn:flowNodeRef>AUTH1_LINK_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_provider</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_no_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AUTH1_LINK_lane_1" name="Платформа ВЕРО">
        <bpmn:flowNodeRef>AUTH1_LINK_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_LINK_link</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AUTH1_LINK_start" name="Аккаунт уже создан">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:outgoing>AUTH1_LINK_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AUTH1_LINK_choose" name="Выбрать «Подключить Mos ID»">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_0</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_LINK_provider" name="Войти в mos.ru">
      <bpmn:documentation>Участник: Пользователь / mos.ru</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_1</bpmn:incoming>
      <bpmn:incoming>AUTH1_LINK_flow_6</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_LINK_consent" name="Разрешить передачу данных">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_2</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_LINK_valid" name="Авторизация подтверждена?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_3</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_4</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_LINK_flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_LINK_error" name="Ошибка / отмена; аккаунт не изменён">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_4</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_LINK_retry" name="Повторить?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_5</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_6</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_LINK_flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="AUTH1_LINK_cancel" name="Привязка не выполнена">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="AUTH1_LINK_free" name="Mos ID свободен для этого аккаунта?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_8</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_9</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_LINK_flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_LINK_conflict" name="Сообщить о другой привязке; аккаунты не объединять">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_9</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_LINK_no_change" name="Существующий аккаунт сохранён">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="AUTH1_LINK_link" name="Сохранить Mos ID в текущем аккаунте">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_11</bpmn:incoming>
      <bpmn:outgoing>AUTH1_LINK_flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_LINK_done" name="Дополнительный способ входа подключён">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_LINK_flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_0" sourceRef="AUTH1_LINK_start" targetRef="AUTH1_LINK_choose" name="" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_1" sourceRef="AUTH1_LINK_choose" targetRef="AUTH1_LINK_provider" name="" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_2" sourceRef="AUTH1_LINK_provider" targetRef="AUTH1_LINK_consent" name="" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_3" sourceRef="AUTH1_LINK_consent" targetRef="AUTH1_LINK_valid" name="" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_4" sourceRef="AUTH1_LINK_valid" targetRef="AUTH1_LINK_error" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_5" sourceRef="AUTH1_LINK_error" targetRef="AUTH1_LINK_retry" name="" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_6" sourceRef="AUTH1_LINK_retry" targetRef="AUTH1_LINK_provider" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_7" sourceRef="AUTH1_LINK_retry" targetRef="AUTH1_LINK_cancel" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_8" sourceRef="AUTH1_LINK_valid" targetRef="AUTH1_LINK_free" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_9" sourceRef="AUTH1_LINK_free" targetRef="AUTH1_LINK_conflict" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_10" sourceRef="AUTH1_LINK_conflict" targetRef="AUTH1_LINK_no_change" name="" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_11" sourceRef="AUTH1_LINK_free" targetRef="AUTH1_LINK_link" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_LINK_flow_12" sourceRef="AUTH1_LINK_link" targetRef="AUTH1_LINK_done" name="" />
  </bpmn:process>
  <bpmn:collaboration id="AUTH1_LINK_collaboration">
    <bpmn:participant id="AUTH1_LINK_pool" name="Необязательная привязка mos.ru" processRef="AUTH1_LINK" />
  </bpmn:collaboration>
