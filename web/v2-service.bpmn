<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="v2_service_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант 2 · подключение соты ОССиГ" isExecutable="false">
    <bpmn:documentation>Вход, членство в компании и полномочия сервиса независимы. Пока проверки не пройдены, общий кабинет работает. Предлагаемый вариант; версия 1.4.1. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:documentation>Выбрать соту ОССиГ и подтверждённую организацию. При отсутствии связи сначала пройти подключение компании.
Указать роль: отходообразователь, отходоперевозчик или отходополучатель; принять условия сервиса.
Проверить сведения организации в реестрах и необходимые полномочия пользователя. Ошибка не блокирует общий кабинет, но не открывает операции ОССиГ.
Руководитель действует в пределах подтверждённых полномочий; сотруднику проверить подходящую действующую МЧД: доверитель, представитель, полномочия, срок и отзыв.
Если МЧД нет или она не подходит, подготовить её руководителю. Руководитель проверяет сведения и подписывает УКЭП. Сотрудник свою МЧД не подписывает.
После проверки МЧД повторно проверить готовность сервиса. Только успешный результат открывает соответствующие операции; административные права из МЧД автоматически не следуют.
Состав обязательных сведений, полномочий и проверок нужно уточнить по соглашению и техническим условиям интеграции. Это проект процесса, не юридическое заключение и не реализация API.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="ПОЛЬЗОВАТЕЛЬ">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Role</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FixChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MchdChoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="ПЛАТФОРМА">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OrgOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Power</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MchdOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Signature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="РУКОВОДИТЕЛЬ">
        <bpmn:flowNodeRef>SignRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignLater</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sign</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Выбрана сота">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Role" name="Подключить компанию; выбрать роль и принять условия ОССиГ">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Check" name="Проверить компанию, сведения реестров и полномочия">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="OrgOK" name="Сведения подходят?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Fix" name="Уточнить сведения; повторить или вернуться в кабинет">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="FixChoice" name="Повторить?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Leave" name="Личный кабинет доступен">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SignRetry" name="Повторить подпись?">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SignLater" name="Кабинет работает; МЧД ожидает">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Power" name="Полномочия есть?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Existing" name="Указать действующую МЧД или подготовить новую">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="MchdChoice" name="МЧД есть?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Validate" name="Проверить доверителя, представителя, срок, отзыв и полномочия">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MchdOK" name="МЧД подходит?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Prepare" name="Сформировать МЧД; направить руководителю">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Sign" name="Проверить сотрудника и полномочия; подписать УКЭП">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Signature" name="Проверить подпись и действительность МЧД">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Signed" name="Проверка успешна?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Ready" name="Активировать только проверенные операции ОССиГ">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Сервис доступен">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Role" />
    <bpmn:sequenceFlow id="F1" sourceRef="Role" targetRef="Check" />
    <bpmn:sequenceFlow id="F2" sourceRef="Check" targetRef="OrgOK" />
    <bpmn:sequenceFlow id="F3" sourceRef="OrgOK" targetRef="Fix" name="Нет" />
    <bpmn:sequenceFlow id="F4" sourceRef="Fix" targetRef="FixChoice" />
    <bpmn:sequenceFlow id="F5" sourceRef="FixChoice" targetRef="Role" name="Да" />
    <bpmn:sequenceFlow id="F6" sourceRef="FixChoice" targetRef="Leave" name="Позже" />
    <bpmn:sequenceFlow id="F7" sourceRef="OrgOK" targetRef="Power" name="Да" />
    <bpmn:sequenceFlow id="F8" sourceRef="Power" targetRef="Ready" name="Да: руководитель или ранее проверенная МЧД" />
    <bpmn:sequenceFlow id="F9" sourceRef="Power" targetRef="Existing" name="Нет" />
    <bpmn:sequenceFlow id="F10" sourceRef="Existing" targetRef="MchdChoice" />
    <bpmn:sequenceFlow id="F11" sourceRef="MchdChoice" targetRef="Validate" name="Да" />
    <bpmn:sequenceFlow id="F12" sourceRef="Validate" targetRef="MchdOK" />
    <bpmn:sequenceFlow id="F13" sourceRef="MchdOK" targetRef="Check" name="Да: повторно проверить готовность" />
    <bpmn:sequenceFlow id="F14" sourceRef="MchdOK" targetRef="Prepare" name="Нет" />
    <bpmn:sequenceFlow id="F15" sourceRef="MchdChoice" targetRef="Prepare" name="Нет: нужна новая" />
    <bpmn:sequenceFlow id="F16" sourceRef="Prepare" targetRef="Sign" />
    <bpmn:sequenceFlow id="F17" sourceRef="Sign" targetRef="Signature" />
    <bpmn:sequenceFlow id="F18" sourceRef="Signature" targetRef="Signed" />
    <bpmn:sequenceFlow id="F19" sourceRef="Signed" targetRef="SignRetry" name="Ошибка / нет УКЭП" />
    <bpmn:sequenceFlow id="F20" sourceRef="SignRetry" targetRef="Sign" name="Да" />
    <bpmn:sequenceFlow id="F21" sourceRef="SignRetry" targetRef="SignLater" name="Позже" />
    <bpmn:sequenceFlow id="F22" sourceRef="Signed" targetRef="Check" name="Да: повторить проверку готовности" />
    <bpmn:sequenceFlow id="F23" sourceRef="Ready" targetRef="End" />
  </bpmn:process>
