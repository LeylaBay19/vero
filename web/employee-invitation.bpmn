<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="employee_invitation_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант · сотрудник по приглашению" isExecutable="false">
    <bpmn:documentation>Организация подключена. Администратор указал email сотрудника и назначил права в приглашении. Предлагаемый вариант по решению пользователя, 03.11.2026. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:documentation>Статус: предлагаемый процесс (to-be). Источники: docs/PRODUCT.md, PR-REG-EMP и PR-REG-CONTACT; src/proposal-flow.js.
Предусловие: организация уже подключена, уполномоченный администратор сформировал приглашение. Участники регистрации: сотрудник и платформа; создание приглашения выполняется до её начала.
Данные приглашения: ФИО, email получателя, организация, назначенные обычные права кабинета. Права включают работу с объектами, заявками, командой и финансами в пределах выбранного администратором набора.
Существующий аккаунт: ввести email и действующий пароль. Новый аккаунт: ФИО и email берутся из приглашения, сотрудник задаёт и повторяет пароль и принимает условия. Отдельные страницы подтверждения email и успешного создания аккаунта не используются.
После входа или создания аккаунта сотрудник просматривает организацию и назначенные права, затем принимает приглашение. Платформа сопоставляет email аккаунта и приглашения.
При несовпадении email членство и доступ не предоставляются. Пользователь может войти с адресом получателя и повторно принять приглашение либо завершить без доступа.
При совпадении платформа подключает сотрудника к организации и предоставляет только назначенные права, после чего открывается кабинет. Административные возможности возможны только при соответствующем назначении; статус гендиректора не присваивается.
Без приглашения показывается обращение к руководителю или администратору организации. Самостоятельных поиска работодателя и запроса доступа нет; эта ветка не запускает регистрацию.
Членство в организации на mos.ru не выдаёт местные права. Отдельная схема mos.ru описывает этот случай; получение сведений об организации остаётся гипотезой интеграции.
Полномочия подписи через МЧД оформляются отдельно руководителем после подключения сотрудника. Они не возникают из обычного приглашения.
Не определены: срок действия и повторная отправка приглашения, восстановление пароля, серверные контракты. Эти правила не добавлены в BPMN как утверждённое поведение.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="Сотрудник">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Password</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Workspace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Платформа">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Приглашение получено">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Open" name="Открыть ссылку приглашения">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Account" name="Есть аккаунт?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Login" name="Ввести email и существующий пароль">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Password" name="Задать и повторить пароль; принять условия">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Merge" name="">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Accept" name="Принять приглашение и назначенные права">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Check" name="Сопоставить аккаунт с email приглашения">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Match" name="Email совпадает?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Ready" name="Предоставить назначенные права">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Workspace" name="Открыть кабинет организации">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Кабинет открыт">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Reject" name="Сообщить: email не совпадает">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Retry" name="Другой email?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RejectedEnd" name="Без доступа">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Open" />
    <bpmn:sequenceFlow id="F1" sourceRef="Open" targetRef="Account" />
    <bpmn:sequenceFlow id="F2" sourceRef="Account" targetRef="Login" name="Да" />
    <bpmn:sequenceFlow id="F3" sourceRef="Account" targetRef="Password" name="Нет" />
    <bpmn:sequenceFlow id="F4" sourceRef="Login" targetRef="Merge" />
    <bpmn:sequenceFlow id="F5" sourceRef="Password" targetRef="Merge" />
    <bpmn:sequenceFlow id="F6" sourceRef="Merge" targetRef="Accept" />
    <bpmn:sequenceFlow id="F7" sourceRef="Accept" targetRef="Check" />
    <bpmn:sequenceFlow id="F8" sourceRef="Check" targetRef="Match" />
    <bpmn:sequenceFlow id="F9" sourceRef="Match" targetRef="Ready" name="Да" />
    <bpmn:sequenceFlow id="F10" sourceRef="Ready" targetRef="Workspace" />
    <bpmn:sequenceFlow id="F11" sourceRef="Workspace" targetRef="End" />
    <bpmn:sequenceFlow id="F12" sourceRef="Match" targetRef="Reject" name="Нет" />
    <bpmn:sequenceFlow id="F13" sourceRef="Reject" targetRef="Retry" />
    <bpmn:sequenceFlow id="F14" sourceRef="Retry" targetRef="RejectedEnd" name="Нет" />
    <bpmn:sequenceFlow id="F15" sourceRef="Retry" targetRef="Login" name="Да" />
  </bpmn:process>
