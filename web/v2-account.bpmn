<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="v2_account_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант 2 · аккаунт и приглашение" isExecutable="false">
    <bpmn:documentation>Личный кабинет сразу после входа; связь с компанией и доступ к ОССиГ проверяются отдельно. Предлагаемый вариант; версия 1.9.0. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:documentation>Войти по email и коду либо через mos.ru. Ветка mos.ru по приглашению дополнительно подтверждает почту получателя; совпадение почт mos.ru и приглашения не требуется.
При неверном коде повторить ввод. При отмене mos.ru вернуться ко входу. ИНН при обычном входе не запрашивается.
Если приглашения нет, открыть личный кабинет с каталогом сервисов и личными черновиками.
Если приглашение есть, проверить срок и отсутствие отзыва, показать компанию и права. После принятия назначить только указанный внутренний доступ; при отказе открыть личный кабинет без членства.
Истёкшее или отозванное приглашение не даёт доступа к компании; пользователь просит новое. Повторный ввод ИНН отсутствует.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="ПОЛЬЗОВАТЕЛЬ">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="ПЛАТФОРМА">
        <bpmn:flowNodeRef>Identity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Usable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Grant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoAccess</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Начало">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Login" name="Войти по email и коду или через mos.ru">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Identity" name="Подтвердить вход; по приглашению — почту получателя">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Вход подтверждён?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Retry" name="Повторить вход / ввод кода">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Invite" name="Есть приглашение?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Check" name="Проверить срок, отзыв и получателя приглашения">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Usable" name="Действует?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Accept" name="Принять или отклонить приглашение">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Принято?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Grant" name="Назначить только доступ из приглашения">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Home" name="Открыть личный кабинет и каталог сервисов">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Кабинет открыт">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Invalid" name="Показать причину; попросить новое приглашение">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="NoAccess" name="Без доступа к компании">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Login" />
    <bpmn:sequenceFlow id="F1" sourceRef="Login" targetRef="Identity" />
    <bpmn:sequenceFlow id="F2" sourceRef="Identity" targetRef="Valid" />
    <bpmn:sequenceFlow id="F3" sourceRef="Valid" targetRef="Retry" name="Нет" />
    <bpmn:sequenceFlow id="F4" sourceRef="Retry" targetRef="Login" name="Повторить" />
    <bpmn:sequenceFlow id="F5" sourceRef="Valid" targetRef="Invite" name="Да" />
    <bpmn:sequenceFlow id="F6" sourceRef="Invite" targetRef="Home" name="Нет: личный кабинет" />
    <bpmn:sequenceFlow id="F7" sourceRef="Invite" targetRef="Check" name="Да" />
    <bpmn:sequenceFlow id="F8" sourceRef="Check" targetRef="Usable" />
    <bpmn:sequenceFlow id="F9" sourceRef="Usable" targetRef="Invalid" name="Нет" />
    <bpmn:sequenceFlow id="F10" sourceRef="Invalid" targetRef="NoAccess" />
    <bpmn:sequenceFlow id="F11" sourceRef="Usable" targetRef="Accept" name="Да" />
    <bpmn:sequenceFlow id="F12" sourceRef="Accept" targetRef="Decision" />
    <bpmn:sequenceFlow id="F13" sourceRef="Decision" targetRef="Grant" name="Да" />
    <bpmn:sequenceFlow id="F14" sourceRef="Decision" targetRef="Home" name="Нет: без членства" />
    <bpmn:sequenceFlow id="F15" sourceRef="Grant" targetRef="Home" />
    <bpmn:sequenceFlow id="F16" sourceRef="Home" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
