<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AUTH1_INVITE_definitions" targetNamespace="https://vero.prototype/processes/v1" exporter="VERO prototype" exporterVersion="1.22.0">
  <bpmn:process id="AUTH1_INVITE" name="Подключение сотрудника по приглашению" isExecutable="false">
    <bpmn:documentation>Получить только назначенный организацией доступ после принятия действующего приглашения. Предлагаемый процесс по текущему прототипу; не исполняемый серверный процесс.</bpmn:documentation>
    <bpmn:laneSet id="AUTH1_INVITE_lanes">
      <bpmn:lane id="AUTH1_INVITE_lane_0" name="Пользователь / руководитель">
        <bpmn:flowNodeRef>AUTH1_INVITE_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_new_password</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AUTH1_INVITE_lane_1" name="Платформа ВЕРО">
        <bpmn:flowNodeRef>AUTH1_INVITE_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_invitation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_INVITE_accept</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AUTH1_INVITE_start" name="Открыть приглашение организации">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:outgoing>AUTH1_INVITE_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AUTH1_INVITE_form" name="Показать приглашение и неизменяемый email">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_0</bpmn:incoming>
      <bpmn:incoming>AUTH1_INVITE_flow_8</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_INVITE_account" name="Уже есть аккаунт?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_1</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_2</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_INVITE_flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_INVITE_new_password" name="Задать пароль, повторить и принять условия">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_2</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_INVITE_login" name="Ввести пароль существующего аккаунта">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_3</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_INVITE_merge" name="Продолжить выбранный путь" gatewayDirection="Converging">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_4</bpmn:incoming>
      <bpmn:incoming>AUTH1_INVITE_flow_5</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="AUTH1_INVITE_valid" name="Данные входа / регистрации верны?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_6</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_7</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_INVITE_flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_INVITE_fix" name="Показать ошибку; исправить ввод">
      <bpmn:documentation>Участник: Платформа / пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_7</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_INVITE_invitation" name="Приглашение действует?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_9</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_10</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_INVITE_flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_INVITE_expired" name="Сообщить об истечении / отзыве; обратиться к организации">
      <bpmn:documentation>Участник: Платформа / сотрудник</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_10</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_INVITE_denied" name="Без доступа к организации">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="AUTH1_INVITE_accept" name="Создать аккаунт при необходимости; принять приглашение">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_12</bpmn:incoming>
      <bpmn:outgoing>AUTH1_INVITE_flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_INVITE_done" name="Вход выполнен с назначенными правами сотрудника">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_INVITE_flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_0" sourceRef="AUTH1_INVITE_start" targetRef="AUTH1_INVITE_form" name="" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_1" sourceRef="AUTH1_INVITE_form" targetRef="AUTH1_INVITE_account" name="" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_2" sourceRef="AUTH1_INVITE_account" targetRef="AUTH1_INVITE_new_password" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_3" sourceRef="AUTH1_INVITE_account" targetRef="AUTH1_INVITE_login" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_4" sourceRef="AUTH1_INVITE_new_password" targetRef="AUTH1_INVITE_merge" name="" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_5" sourceRef="AUTH1_INVITE_login" targetRef="AUTH1_INVITE_merge" name="" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_6" sourceRef="AUTH1_INVITE_merge" targetRef="AUTH1_INVITE_valid" name="" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_7" sourceRef="AUTH1_INVITE_valid" targetRef="AUTH1_INVITE_fix" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_8" sourceRef="AUTH1_INVITE_fix" targetRef="AUTH1_INVITE_form" name="Исправить" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_9" sourceRef="AUTH1_INVITE_valid" targetRef="AUTH1_INVITE_invitation" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_10" sourceRef="AUTH1_INVITE_invitation" targetRef="AUTH1_INVITE_expired" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_11" sourceRef="AUTH1_INVITE_expired" targetRef="AUTH1_INVITE_denied" name="" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_12" sourceRef="AUTH1_INVITE_invitation" targetRef="AUTH1_INVITE_accept" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_INVITE_flow_13" sourceRef="AUTH1_INVITE_accept" targetRef="AUTH1_INVITE_done" name="" />
  </bpmn:process>
  <bpmn:collaboration id="AUTH1_INVITE_collaboration">
    <bpmn:participant id="AUTH1_INVITE_pool" name="Подключение сотрудника по приглашению" processRef="AUTH1_INVITE" />
  </bpmn:collaboration>
