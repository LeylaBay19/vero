<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="employee_mchd_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант · выдача полномочий сотруднику" isExecutable="false">
    <bpmn:documentation>Организация и сотрудник уже подключены. Обычный доступ к кабинету не требует оформления этой МЧД. Предлагаемый вариант; версия 1.2.0. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="ГЕНЕРАЛЬНЫЙ ДИРЕКТОР">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Powers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="ПЛАТФОРМА">
        <bpmn:flowNodeRef>Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Начало">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Powers" name="Выбрать полномочия чекбоксами">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Generate" name="Сформировать МЧД по выбранным правам">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Review" name="Проверить сотрудника и полномочия в МЧД">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Sign" name="Подписать МЧД электронной подписью">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Signed" name="Сохранить подписанную МЧД">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Ready" name="Показать сотруднику оформленные полномочия">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="МЧД подписана">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Powers" />
    <bpmn:sequenceFlow id="F1" sourceRef="Powers" targetRef="Generate" />
    <bpmn:sequenceFlow id="F2" sourceRef="Generate" targetRef="Review" />
    <bpmn:sequenceFlow id="F3" sourceRef="Review" targetRef="Sign" />
    <bpmn:sequenceFlow id="F4" sourceRef="Sign" targetRef="Signed" />
    <bpmn:sequenceFlow id="F5" sourceRef="Signed" targetRef="Ready" />
    <bpmn:sequenceFlow id="F6" sourceRef="Ready" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="250" y="243" width="34" height="34" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="309" width="224" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Powers_di" bpmnElement="Powers">
        <dc:Bounds x="330" y="210" width="260" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Generate_di" bpmnElement="Generate">
        <dc:Bounds x="630" y="520" width="260" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="1030" y="210" width="260" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sign_di" bpmnElement="Sign">
        <dc:Bounds x="1420" y="210" width="260" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Signed_di" bpmnElement="Signed">
        <dc:Bounds x="1420" y="520" width="260" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ready_di" bpmnElement="Ready">
        <dc:Bounds x="1900" y="520" width="300" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="2330" y="553" width="34" height="34" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2235" y="619" width="224" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="person_di" bpmnElement="person" isHorizontal="true">
        <dc:Bounds x="35" y="130" width="2410" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="system_di" bpmnElement="system" isHorizontal="true">
        <dc:Bounds x="35" y="440" width="2410" height="450" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F0_di" bpmnElement="F0">
        <di:waypoint x="284" y="260" />
        <di:waypoint x="330" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="460" y="310" />
        <di:waypoint x="460" y="570" />
        <di:waypoint x="630" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="760" y="520" />
        <di:waypoint x="760" y="260" />
        <di:waypoint x="1030" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="1290" y="260" />
        <di:waypoint x="1420" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="1550" y="310" />
        <di:waypoint x="1550" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="1680" y="570" />
        <di:waypoint x="1900" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="2200" y="570" />
        <di:waypoint x="2330" y="570" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>