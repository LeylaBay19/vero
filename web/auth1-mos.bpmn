<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AUTH1_MOS_definitions" targetNamespace="https://vero.prototype/processes/v1" exporter="VERO prototype" exporterVersion="1.22.0">
  <bpmn:process id="AUTH1_MOS" name="Регистрация и вход через mos.ru" isExecutable="false">
    <bpmn:documentation>Войти по Mos ID или создать личный аккаунт при первом входе. Предлагаемый процесс по текущему прототипу; не исполняемый серверный процесс.</bpmn:documentation>
    <bpmn:startEvent id="AUTH1_MOS_start" name="Выбрать вход через mos.ru">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:outgoing>AUTH1_MOS_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AUTH1_MOS_provider" name="Ввести данные учётной записи mos.ru">
      <bpmn:documentation>Участник: Пользователь / mos.ru</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_0</bpmn:incoming>
      <bpmn:incoming>AUTH1_MOS_flow_5</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_MOS_consent" name="Разрешить передачу данных; для нового аккаунта принять условия">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_1</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_MOS_response" name="Вход подтверждён и данные разрешены?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_2</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_3</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_MOS_flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_MOS_error" name="Показать ошибку или отмену; аккаунт не менять">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_3</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_MOS_retry" name="Повторить вход?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_4</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_5</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_MOS_flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="AUTH1_MOS_cancel" name="Вход не выполнен">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="AUTH1_MOS_known" name="Mos ID уже связан с аккаунтом?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_7</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_8</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_MOS_flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_MOS_existing" name="Сохранить существующие организацию и роль">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_8</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_MOS_entered" name="Вход выполнен; сценарий завершён">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="AUTH1_MOS_new" name="Создать аккаунт без локального пароля">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_10</bpmn:incoming>
      <bpmn:outgoing>AUTH1_MOS_flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_MOS_registered" name="Аккаунт создан; предложить подключение организации">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_MOS_flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_0" sourceRef="AUTH1_MOS_start" targetRef="AUTH1_MOS_provider" name="" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_1" sourceRef="AUTH1_MOS_provider" targetRef="AUTH1_MOS_consent" name="" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_2" sourceRef="AUTH1_MOS_consent" targetRef="AUTH1_MOS_response" name="" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_3" sourceRef="AUTH1_MOS_response" targetRef="AUTH1_MOS_error" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_4" sourceRef="AUTH1_MOS_error" targetRef="AUTH1_MOS_retry" name="" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_5" sourceRef="AUTH1_MOS_retry" targetRef="AUTH1_MOS_provider" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_6" sourceRef="AUTH1_MOS_retry" targetRef="AUTH1_MOS_cancel" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_7" sourceRef="AUTH1_MOS_response" targetRef="AUTH1_MOS_known" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_8" sourceRef="AUTH1_MOS_known" targetRef="AUTH1_MOS_existing" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_9" sourceRef="AUTH1_MOS_existing" targetRef="AUTH1_MOS_entered" name="" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_10" sourceRef="AUTH1_MOS_known" targetRef="AUTH1_MOS_new" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_MOS_flow_11" sourceRef="AUTH1_MOS_new" targetRef="AUTH1_MOS_registered" name="" />
  </bpmn:process>
