<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AUTH1_EMAIL_definitions" targetNamespace="https://vero.prototype/processes/v1" exporter="VERO prototype" exporterVersion="1.23.0">
  <bpmn:process id="AUTH1_EMAIL" name="Регистрация по email" isExecutable="false">
    <bpmn:documentation>Создать подтверждённый личный аккаунт перед подключением организации. Предлагаемый процесс по текущему прототипу; не исполняемый серверный процесс.</bpmn:documentation>
    <bpmn:laneSet id="AUTH1_EMAIL_lanes">
      <bpmn:lane id="AUTH1_EMAIL_lane_0" name="Пользователь / руководитель">
        <bpmn:flowNodeRef>AUTH1_EMAIL_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_password</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_mos_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AUTH1_EMAIL_lane_1" name="Платформа ВЕРО">
        <bpmn:flowNodeRef>AUTH1_EMAIL_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_valid_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_valid_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_EMAIL_create</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AUTH1_EMAIL_start" name="Начать регистрацию">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:outgoing>AUTH1_EMAIL_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AUTH1_EMAIL_email" name="Указать email">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_0</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_EMAIL_mail" name="Показать отправку письма">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_1</bpmn:incoming>
      <bpmn:incoming>AUTH1_EMAIL_flow_6</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_EMAIL_open" name="Открыть письмо и подтвердить email">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_2</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_EMAIL_valid_link" name="Ссылка действительна?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_3</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_4</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_EMAIL_flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_EMAIL_expired" name="Запросить новое письмо">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_5</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_EMAIL_password" name="Задать пароль, повторить и принять условия">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_4</bpmn:incoming>
      <bpmn:incoming>AUTH1_EMAIL_flow_10</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_EMAIL_valid_form" name="Данные и согласие верны?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_7</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_8</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_EMAIL_flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_EMAIL_fix" name="Исправить ввод; остальные данные сохранены">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_9</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_EMAIL_create" name="Создать аккаунт; email становится логином">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_8</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_EMAIL_mos_offer" name="Подключить Mos ID или сделать позже">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_11</bpmn:incoming>
      <bpmn:outgoing>AUTH1_EMAIL_flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AUTH1_EMAIL_done" name="Аккаунт готов; далее подключение организации">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_EMAIL_flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_0" sourceRef="AUTH1_EMAIL_start" targetRef="AUTH1_EMAIL_email" name="" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_1" sourceRef="AUTH1_EMAIL_email" targetRef="AUTH1_EMAIL_mail" name="" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_2" sourceRef="AUTH1_EMAIL_mail" targetRef="AUTH1_EMAIL_open" name="" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_3" sourceRef="AUTH1_EMAIL_open" targetRef="AUTH1_EMAIL_valid_link" name="" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_4" sourceRef="AUTH1_EMAIL_valid_link" targetRef="AUTH1_EMAIL_password" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_5" sourceRef="AUTH1_EMAIL_valid_link" targetRef="AUTH1_EMAIL_expired" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_6" sourceRef="AUTH1_EMAIL_expired" targetRef="AUTH1_EMAIL_mail" name="Новое письмо" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_7" sourceRef="AUTH1_EMAIL_password" targetRef="AUTH1_EMAIL_valid_form" name="" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_8" sourceRef="AUTH1_EMAIL_valid_form" targetRef="AUTH1_EMAIL_create" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_9" sourceRef="AUTH1_EMAIL_valid_form" targetRef="AUTH1_EMAIL_fix" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_10" sourceRef="AUTH1_EMAIL_fix" targetRef="AUTH1_EMAIL_password" name="Повторить" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_11" sourceRef="AUTH1_EMAIL_create" targetRef="AUTH1_EMAIL_mos_offer" name="" />
    <bpmn:sequenceFlow id="AUTH1_EMAIL_flow_12" sourceRef="AUTH1_EMAIL_mos_offer" targetRef="AUTH1_EMAIL_done" name="" />
  </bpmn:process>
  <bpmn:collaboration id="AUTH1_EMAIL_collaboration">
    <bpmn:participant id="AUTH1_EMAIL_pool" name="Регистрация по email" processRef="AUTH1_EMAIL" />
  </bpmn:collaboration>
