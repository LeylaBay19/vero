<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="AUTH1_PASSWORD_definitions" targetNamespace="https://vero.prototype/processes/v1" exporter="VERO prototype" exporterVersion="1.22.0">
  <bpmn:process id="AUTH1_PASSWORD" name="Вход по email и восстановление пароля" isExecutable="false">
    <bpmn:documentation>Войти в существующий аккаунт; при необходимости восстановить пароль. Предлагаемый процесс по текущему прототипу; не исполняемый серверный процесс.</bpmn:documentation>
    <bpmn:laneSet id="AUTH1_PASSWORD_lanes">
      <bpmn:lane id="AUTH1_PASSWORD_lane_0" name="Пользователь / руководитель">
        <bpmn:flowNodeRef>AUTH1_PASSWORD_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_password</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AUTH1_PASSWORD_lane_1" name="Платформа ВЕРО">
        <bpmn:flowNodeRef>AUTH1_PASSWORD_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AUTH1_PASSWORD_save</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AUTH1_PASSWORD_start" name="Начать вход">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AUTH1_PASSWORD_login" name="Ввести email и пароль">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_0</bpmn:incoming>
      <bpmn:incoming>AUTH1_PASSWORD_flow_5</bpmn:incoming>
      <bpmn:incoming>AUTH1_PASSWORD_flow_17</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_PASSWORD_valid" name="Данные входа верны?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_1</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_2</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="AUTH1_PASSWORD_done" name="Вход выполнен; организация и роль сохранены">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="AUTH1_PASSWORD_error" name="Сообщить об ошибке входа">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_3</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_PASSWORD_recover" name="Восстановить пароль?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_4</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_5</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_PASSWORD_email" name="Указать email аккаунта">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_6</bpmn:incoming>
      <bpmn:incoming>AUTH1_PASSWORD_flow_11</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_PASSWORD_mail" name="Показать нейтральное сообщение об отправке письма">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_7</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_PASSWORD_open" name="Открыть письмо и ссылку восстановления">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_8</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_PASSWORD_link" name="Ссылка действительна?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_9</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_10</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_PASSWORD_expired" name="Запросить новое письмо">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_10</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_PASSWORD_password" name="Задать новый пароль и повторить">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_12</bpmn:incoming>
      <bpmn:incoming>AUTH1_PASSWORD_flow_15</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="AUTH1_PASSWORD_match" name="Новый пароль корректен и совпадает?" gatewayDirection="Diverging">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_13</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_14</bpmn:outgoing>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AUTH1_PASSWORD_fix" name="Исправить пароль; остальные данные сохранены">
      <bpmn:documentation>Участник: Пользователь</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_14</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AUTH1_PASSWORD_save" name="Сохранить новый пароль; старый больше не подходит">
      <bpmn:documentation>Участник: Платформа</bpmn:documentation>
      <bpmn:incoming>AUTH1_PASSWORD_flow_16</bpmn:incoming>
      <bpmn:outgoing>AUTH1_PASSWORD_flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_0" sourceRef="AUTH1_PASSWORD_start" targetRef="AUTH1_PASSWORD_login" name="" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_1" sourceRef="AUTH1_PASSWORD_login" targetRef="AUTH1_PASSWORD_valid" name="" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_2" sourceRef="AUTH1_PASSWORD_valid" targetRef="AUTH1_PASSWORD_done" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_3" sourceRef="AUTH1_PASSWORD_valid" targetRef="AUTH1_PASSWORD_error" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_4" sourceRef="AUTH1_PASSWORD_error" targetRef="AUTH1_PASSWORD_recover" name="" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_5" sourceRef="AUTH1_PASSWORD_recover" targetRef="AUTH1_PASSWORD_login" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_6" sourceRef="AUTH1_PASSWORD_recover" targetRef="AUTH1_PASSWORD_email" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_7" sourceRef="AUTH1_PASSWORD_email" targetRef="AUTH1_PASSWORD_mail" name="" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_8" sourceRef="AUTH1_PASSWORD_mail" targetRef="AUTH1_PASSWORD_open" name="" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_9" sourceRef="AUTH1_PASSWORD_open" targetRef="AUTH1_PASSWORD_link" name="" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_10" sourceRef="AUTH1_PASSWORD_link" targetRef="AUTH1_PASSWORD_expired" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_11" sourceRef="AUTH1_PASSWORD_expired" targetRef="AUTH1_PASSWORD_email" name="Новое письмо" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_12" sourceRef="AUTH1_PASSWORD_link" targetRef="AUTH1_PASSWORD_password" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_13" sourceRef="AUTH1_PASSWORD_password" targetRef="AUTH1_PASSWORD_match" name="" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_14" sourceRef="AUTH1_PASSWORD_match" targetRef="AUTH1_PASSWORD_fix" name="Нет" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_15" sourceRef="AUTH1_PASSWORD_fix" targetRef="AUTH1_PASSWORD_password" name="Исправить" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_16" sourceRef="AUTH1_PASSWORD_match" targetRef="AUTH1_PASSWORD_save" name="Да" />
    <bpmn:sequenceFlow id="AUTH1_PASSWORD_flow_17" sourceRef="AUTH1_PASSWORD_save" targetRef="AUTH1_PASSWORD_login" name="Войти с новым паролем" />
  </bpmn:process>
  <bpmn:collaboration id="AUTH1_PASSWORD_collaboration">
    <bpmn:participant id="AUTH1_PASSWORD_pool" name="Вход по email и восстановление пароля" processRef="AUTH1_PASSWORD" />
