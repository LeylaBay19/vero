<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="organization_registration_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант · регистрация организации" isExecutable="false">
    <bpmn:documentation>Организацию регистрирует только генеральный директор. Сотрудники не могут создать её кабинет. Предлагаемый вариант по решению пользователя, 03.11.2026. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:documentation>Статус: предлагаемый процесс (to-be), а не исполняемая серверная система. Источники: docs/PRODUCT.md, PR-REG-ORG; src/proposal-flow.js.
Участники: генеральный директор и платформа. Только гендиректор регистрирует юридическое лицо; администратор не приравнивается к гендиректору.
Входные данные: личный аккаунт, ИНН, реквизиты организации и заявление с ЭП генерального директора. Личный аккаунт можно создать либо войти в существующий; в прототипе доступны email/пароль и демонстрация mos.ru.
Если организация уже подключена, повторная регистрация прекращается: пользователь обращается в организацию за приглашением. Самостоятельный запрос доступа не создаётся.
Новая организация: проверить реквизиты → подписать заявление ЭП гендиректора → дождаться обязательной проверки платформой. До успешного результата кабинет организации и приглашение сотрудников недоступны.
При отказе платформа показывает причину; организация и административные права не предоставляются. Можно вернуться к реквизитам и повторно пройти подписание и проверку либо завершить без подключения.
После положительной проверки платформа подключает организацию и назначает гендиректору права администратора. Он может открыть кабинет; приглашение сотрудников — последующее необязательное действие.
Для приглашения указываются ФИО, email и обычные права кабинета. Отправка приглашения не подключает сотрудника автоматически: он должен войти и принять его в отдельном процессе.
Обычные права кабинета отделены от полномочий подписи документов. МЧД оформляется отдельно и действует в прототипе только после подписи руководителя.
Не определены: технический способ и сроки проверки платформой, полные требования к паролю и восстановлению доступа. Реальные ЭП и серверная проверка в прототипе не подключены.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="Генеральный директор">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExistingEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Платформа">
        <bpmn:flowNodeRef>Lookup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Начало">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Auth" name="Войти / создать личный аккаунт">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="INN" name="Ввести ИНН организации">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Lookup" name="Найти организацию">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Exists" name="Уже подключена?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Request" name="Обратиться в свою организацию">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ExistingEnd" name="Нужно приглашение">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Record" name="Проверить реквизиты">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Sign" name="Подписать заявление ЭП гендиректора">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Check" name="Проверить данные и полномочия">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Проверка пройдена?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Ready" name="Подключить компанию и дать права админа">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Invite" name="Открыть кабинет; при необходимости пригласить сотрудников">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Кабинет готов">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Reject" name="Отклонить заявку: указать причину">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Retry" name="Исправить данные?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RejectedEnd" name="Не подключена">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Auth" />
    <bpmn:sequenceFlow id="F1" sourceRef="Auth" targetRef="INN" />
    <bpmn:sequenceFlow id="F2" sourceRef="INN" targetRef="Lookup" />
    <bpmn:sequenceFlow id="F3" sourceRef="Lookup" targetRef="Exists" />
    <bpmn:sequenceFlow id="F4" sourceRef="Exists" targetRef="Request" name="Да" />
    <bpmn:sequenceFlow id="F5" sourceRef="Request" targetRef="ExistingEnd" />
    <bpmn:sequenceFlow id="F6" sourceRef="Exists" targetRef="Record" name="Нет" />
    <bpmn:sequenceFlow id="F7" sourceRef="Record" targetRef="Sign" />
    <bpmn:sequenceFlow id="F8" sourceRef="Sign" targetRef="Check" />
    <bpmn:sequenceFlow id="F9" sourceRef="Check" targetRef="Valid" />
    <bpmn:sequenceFlow id="F10" sourceRef="Valid" targetRef="Ready" name="Да" />
    <bpmn:sequenceFlow id="F11" sourceRef="Ready" targetRef="Invite" />
    <bpmn:sequenceFlow id="F12" sourceRef="Invite" targetRef="End" />
    <bpmn:sequenceFlow id="F13" sourceRef="Valid" targetRef="Reject" name="Нет" />
    <bpmn:sequenceFlow id="F14" sourceRef="Reject" targetRef="Retry" />
    <bpmn:sequenceFlow id="F15" sourceRef="Retry" targetRef="RejectedEnd" name="Нет" />
    <bpmn:sequenceFlow id="F16" sourceRef="Retry" targetRef="Record" name="Да" />
  </bpmn:process>
