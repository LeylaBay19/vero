    <bpmn:sequenceFlow id="F9" sourceRef="Applicant" targetRef="Record" name="Да" />
    <bpmn:sequenceFlow id="F10" sourceRef="Applicant" targetRef="ContactOrg" name="Нет" />
    <bpmn:sequenceFlow id="F11" sourceRef="ContactOrg" targetRef="ContactEnd" />
    <bpmn:sequenceFlow id="F12" sourceRef="Record" targetRef="Sign" />
    <bpmn:sequenceFlow id="F13" sourceRef="Sign" targetRef="Check" />
    <bpmn:sequenceFlow id="F14" sourceRef="Check" targetRef="Valid" />
    <bpmn:sequenceFlow id="F15" sourceRef="Valid" targetRef="Ready" name="Да" />
    <bpmn:sequenceFlow id="F16" sourceRef="Ready" targetRef="Cabinet" />
    <bpmn:sequenceFlow id="F17" sourceRef="Cabinet" targetRef="End" />
    <bpmn:sequenceFlow id="F18" sourceRef="Valid" targetRef="Reject" name="Нет" />
    <bpmn:sequenceFlow id="F19" sourceRef="Reject" targetRef="Retry" />
    <bpmn:sequenceFlow id="F20" sourceRef="Retry" targetRef="RejectedEnd" name="Нет" />
    <bpmn:sequenceFlow id="F21" sourceRef="Retry" targetRef="Record" name="Да" />
  </bpmn:process>
