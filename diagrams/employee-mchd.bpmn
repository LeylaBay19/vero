<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="employee_mchd_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант · выдача полномочий сотруднику" isExecutable="false">
    <bpmn:documentation>Обычный доступ уже действует. Изменение полномочий требует нового формирования и подписи МЧД. Предлагаемый вариант; версия 1.3.1. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:documentation>При ошибке подписи или отсутствии УКЭП новые полномочия не активируются: можно повторить либо отложить. Изменение данных возвращает к выбору полномочий и формированию новой МЧД.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="ГЕНЕРАЛЬНЫЙ ДИРЕКТОР">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Powers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="ПЛАТФОРМА">
        <bpmn:flowNodeRef>Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deferred</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Начало">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Powers" name="Выбрать непустой набор полномочий">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Generate" name="Сформировать МЧД по выбранным полномочиям">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Review" name="Проверить сотрудника и полномочия в МЧД">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Choice" name="Данные верны?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Sign" name="Подписать МЧД УКЭП руководителя">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Verify" name="Проверить получение и корректность подписи">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Подпись верна?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Ready" name="Сохранить МЧД и показать проверенные полномочия">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="МЧД подписана">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Retry" name="Повторить?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Deferred" name="Без новых полномочий; кабинет доступен">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Powers" />
    <bpmn:sequenceFlow id="F1" sourceRef="Powers" targetRef="Generate" />
    <bpmn:sequenceFlow id="F2" sourceRef="Generate" targetRef="Review" />
    <bpmn:sequenceFlow id="F3" sourceRef="Review" targetRef="Choice" />
    <bpmn:sequenceFlow id="F4" sourceRef="Choice" targetRef="Sign" name="Да" />
    <bpmn:sequenceFlow id="F5" sourceRef="Choice" targetRef="Powers" name="Нет: изменить и сформировать заново" />
    <bpmn:sequenceFlow id="F6" sourceRef="Sign" targetRef="Verify" />
    <bpmn:sequenceFlow id="F7" sourceRef="Verify" targetRef="Valid" />
    <bpmn:sequenceFlow id="F8" sourceRef="Valid" targetRef="Ready" name="Да" />
    <bpmn:sequenceFlow id="F9" sourceRef="Ready" targetRef="End" />
    <bpmn:sequenceFlow id="F10" sourceRef="Valid" targetRef="Retry" name="Ошибка / нет УКЭП" />
    <bpmn:sequenceFlow id="F11" sourceRef="Retry" targetRef="Sign" name="Да" />
    <bpmn:sequenceFlow id="F12" sourceRef="Retry" targetRef="Deferred" name="Позже" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="250" y="243" width="34" height="34" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="309" width="224" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Powers_di" bpmnElement="Powers">
