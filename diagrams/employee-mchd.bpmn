      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1965" y="595" />
        <di:waypoint x="1965" y="755" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2000" y="664" width="220" height="32" />
        </bpmndi:BPMNLabel>
