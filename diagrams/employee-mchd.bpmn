      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="1940" y="780" />
        <di:waypoint x="1490" y="780" />
        <di:waypoint x="1490" y="260" />
        <di:waypoint x="1570" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1530" y="739" width="220" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
