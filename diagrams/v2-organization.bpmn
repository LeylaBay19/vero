<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="v2_organization_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант 2 · подключение организации" isExecutable="false">
    <bpmn:documentation>Подготовка реквизитов не выдаёт права. Существующая компания используется повторно, без дублей. Предлагаемый вариант; версия 1.6.0. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:documentation>Из личного кабинета найти компанию или ИП по ИНН и проверить реквизиты. До проверки доступны только личные данные и черновики.
Проверить существующую запись и членство: не создавать дубликат организации. Подтверждённому участнику открыть существующий доступ.
Сотрудник без полномочий сохраняет подготовку для руководителя либо обращается за приглашением. Эти действия не назначают прав.
Руководитель или ИП подтверждает полномочия УКЭП. Представитель использует личную УКЭП и подходящую действующую МЧД.
Успешная проверка подключает организацию с подтверждённой ролью. При ошибке или отсутствии УКЭП сохранить подготовку и продолжить в личном кабинете. Ручная проверка и её сроки требуют отдельного регламента.
Уполномоченный руководитель приглашает сотрудников на любую почту. Представителю не присваиваются права руководителя автоматически.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="ПОЛЬЗОВАТЕЛЬ">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>INN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="ПЛАТФОРМА">
        <bpmn:flowNodeRef>Find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Linked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Connect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Personal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="РУКОВОДИТЕЛЬ / ПРЕДСТАВИТЕЛЬ">
        <bpmn:flowNodeRef>Authority</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Личный аккаунт">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="INN" name="Найти организацию или ИП по ИНН">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Find" name="Найти реквизиты, запись компании и сохранённый доступ">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Linked" name="Доступ уже есть?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Record" name="Проверить реквизиты; выбрать способ подключения">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Choice" name="Подтвердить сейчас?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Authority" name="Руководитель: УКЭП. Представитель: УКЭП и подходящая МЧД">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Verify" name="Проверить личность и полномочия">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Проверка успешна?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Connect" name="Связать аккаунт с компанией; назначить подтверждённую роль">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Home" name="Открыть кабинет с назначенным доступом">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Компания подключена">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Prepare" name="Сохранить подготовку; показать обращение за приглашением">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Retry" name="Повторить проверку?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Pending" name="Сохранить причину ошибки или отсутствие УКЭП">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Personal" name="Личный кабинет без прав компании">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="INN" />
    <bpmn:sequenceFlow id="F1" sourceRef="INN" targetRef="Find" />
    <bpmn:sequenceFlow id="F2" sourceRef="Find" targetRef="Linked" />
    <bpmn:sequenceFlow id="F3" sourceRef="Linked" targetRef="Home" name="Да: существующий доступ" />
    <bpmn:sequenceFlow id="F4" sourceRef="Linked" targetRef="Record" name="Нет" />
    <bpmn:sequenceFlow id="F5" sourceRef="Record" targetRef="Choice" />
    <bpmn:sequenceFlow id="F6" sourceRef="Choice" targetRef="Authority" name="Да" />
    <bpmn:sequenceFlow id="F7" sourceRef="Choice" targetRef="Prepare" name="Позже / нет полномочий" />
    <bpmn:sequenceFlow id="F8" sourceRef="Prepare" targetRef="Personal" />
    <bpmn:sequenceFlow id="F9" sourceRef="Authority" targetRef="Verify" />
    <bpmn:sequenceFlow id="F10" sourceRef="Verify" targetRef="Valid" />
    <bpmn:sequenceFlow id="F11" sourceRef="Valid" targetRef="Connect" name="Да" />
    <bpmn:sequenceFlow id="F12" sourceRef="Valid" targetRef="Pending" name="Нет" />
    <bpmn:sequenceFlow id="F13" sourceRef="Pending" targetRef="Retry" />
    <bpmn:sequenceFlow id="F14" sourceRef="Retry" targetRef="Authority" name="Да" />
    <bpmn:sequenceFlow id="F15" sourceRef="Retry" targetRef="Personal" name="Позже" />
    <bpmn:sequenceFlow id="F16" sourceRef="Connect" targetRef="Home" />
    <bpmn:sequenceFlow id="F17" sourceRef="Home" targetRef="End" />
  </bpmn:process>
