<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="employee_invitation_defs" targetNamespace="urn:proposed:registration">
  <bpmn:process id="Process" name="Предлагаемый вариант · единое подключение сотрудника" isExecutable="false">
    <bpmn:documentation>Приглашение на любую почту → mos.ru без повторного ИНН → принятие → МЧД руководителю, если нужна. Предлагаемый вариант; версия 1.7.0. Технический механизм проверки платформой и сроки не определены.</bpmn:documentation>
    <bpmn:documentation>Предлагаемый процесс ВЕРО по решению пользователя от 04.11.2026. Источники: docs/PRODUCT.md, PR-REG-EMP; src/proposal-flow.js. Это не описание интеграции Тринити.
Предусловие: организация проверена. Руководитель или уполномоченный администратор создаёт приглашение с ФИО, любой личной/корпоративной почтой, организацией, ИНН, обычными правами и необязательными полномочиями МЧД.
Полномочия выбираются один раз при приглашении. Сотрудник входит через mos.ru. Почта mos.ru может отличаться от почты приглашения. Организация и ИНН восстанавливаются из сохранённого приглашения; повторного ввода ИНН нет.
При отмене входа приглашение сохраняется; доступ не выдаётся. Платформа проверяет связь приглашения и вошедшего аккаунта. При неверном контексте подключение не выполняется.
Сотрудник проверяет свои данные, организацию, права и подтверждает принятие. Только после этого он получает назначенный обычный доступ к кабинету.
Без выбранных полномочий МЧД не формируется. С выбранными полномочиями платформа автоматически формирует МЧД и направляет её руководителю. Обычный кабинет доступен; полномочия МЧД ожидают подписи.
Руководитель проверяет сотрудника и МЧД, при необходимости исправляет полномочия и подписывает своей УКЭП. Сотрудник МЧД не подписывает. После успешной проверки подписи и действительности МЧД соответствующие полномочия активируются. При ошибке они недоступны; подпись можно повторить.
МЧД не выдаёт обычные административные права и не присваивает статус гендиректора. Подписывать документы сотрудник далее будет собственной УКЭП в пределах выданных полномочий.
Без приглашения сотрудник обращается в организацию. Членство на mos.ru само по себе не выдаёт местные права. Получение организации из mos.ru в отдельном кейсе остаётся гипотезой.
Стенд имитирует mos.ru, доставку, создание МЧД и подпись; хранит контекст в памяти текущего сеанса. Реальная интеграция, привязка личности и почты, срок и отзыв приглашения, реестр МЧД не реализованы. Пересланная ссылка не должна автоматически давать полномочия в промышленной системе.
После направления МЧД руководителю ветки независимы: сотрудник уже работает с обычным доступом, а полномочия МЧД ожидают проверки подписи. Параллельный шлюз не требует ожидать подпись для входа в кабинет.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="person" name="СОТРУДНИК">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Without</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndWithout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PendingCabinet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PendingEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="ПЛАТФОРМА">
        <bpmn:flowNodeRef>AuthOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Restore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Grant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignatureOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="director" name="ГЕНЕРАЛЬНЫЙ ДИРЕКТОР">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sign</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Приглашение получено">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Open" name="Открыть приглашение на личной или рабочей почте">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Mos" name="Войти через свой аккаунт mos.ru">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="AuthOK" name="Вход выполнен?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Cancel" name="Вернуться к сохранённому приглашению">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Restore" name="Восстановить приглашение, организацию и ИНН">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Accept" name="Проверить свои данные, организацию и права; принять приглашение">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Проверить связь приглашения с вошедшим аккаунтом">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Match" name="Контекст верен?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Reject" name="Не предоставлять доступ; предложить открыть приглашение заново">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RejectedEnd" name="Без доступа">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Grant" name="Подключить сотрудника; выдать обычные права кабинета">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Need" name="Нужна МЧД?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Without" name="Открыть кабинет без МЧД">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndWithout" name="Подключён без МЧД">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Generate" name="Сформировать МЧД по полномочиям приглашения; направить руководителю">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Parallel" name="Кабинет и МЧД">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="PendingCabinet" name="Работать в кабинете; полномочия МЧД пока не действуют">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PendingEnd" name="Обычный доступ активен">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Review" name="Проверить сотрудника и сформированную МЧД">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Sign" name="Подписать МЧД УКЭП руководителя">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Verify" name="Проверить подпись и действительность МЧД">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SignatureOK" name="Подпись верна?">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activate" name="После успешной проверки активировать только полномочия МЧД">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="МЧД действует">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="Open" />
    <bpmn:sequenceFlow id="F1" sourceRef="Open" targetRef="Mos" />
    <bpmn:sequenceFlow id="F2" sourceRef="Mos" targetRef="AuthOK" />
    <bpmn:sequenceFlow id="F3" sourceRef="AuthOK" targetRef="Cancel" name="Отмена" />
    <bpmn:sequenceFlow id="F4" sourceRef="Cancel" targetRef="Open" name="Повторить вход" />
    <bpmn:sequenceFlow id="F5" sourceRef="AuthOK" targetRef="Restore" name="Да" />
    <bpmn:sequenceFlow id="F6" sourceRef="Restore" targetRef="Accept" />
    <bpmn:sequenceFlow id="F7" sourceRef="Accept" targetRef="Check" />
    <bpmn:sequenceFlow id="F8" sourceRef="Check" targetRef="Match" />
    <bpmn:sequenceFlow id="F9" sourceRef="Match" targetRef="Reject" name="Нет" />
    <bpmn:sequenceFlow id="F10" sourceRef="Reject" targetRef="RejectedEnd" />
    <bpmn:sequenceFlow id="F11" sourceRef="Match" targetRef="Grant" name="Да" />
    <bpmn:sequenceFlow id="F12" sourceRef="Grant" targetRef="Need" />
    <bpmn:sequenceFlow id="F13" sourceRef="Need" targetRef="Without" name="Нет" />
    <bpmn:sequenceFlow id="F14" sourceRef="Without" targetRef="EndWithout" />
    <bpmn:sequenceFlow id="F15" sourceRef="Need" targetRef="Generate" name="Да" />
    <bpmn:sequenceFlow id="F16" sourceRef="Generate" targetRef="Parallel" />
    <bpmn:sequenceFlow id="F17" sourceRef="Parallel" targetRef="Review" />
    <bpmn:sequenceFlow id="F18" sourceRef="Parallel" targetRef="PendingCabinet" />
    <bpmn:sequenceFlow id="F19" sourceRef="PendingCabinet" targetRef="PendingEnd" />
    <bpmn:sequenceFlow id="F20" sourceRef="Review" targetRef="Sign" />
    <bpmn:sequenceFlow id="F21" sourceRef="Sign" targetRef="Verify" />
    <bpmn:sequenceFlow id="F22" sourceRef="Verify" targetRef="SignatureOK" />
    <bpmn:sequenceFlow id="F23" sourceRef="SignatureOK" targetRef="Activate" name="Да" />
    <bpmn:sequenceFlow id="F24" sourceRef="SignatureOK" targetRef="Sign" name="Ошибка: исправить и повторить" />
    <bpmn:sequenceFlow id="F25" sourceRef="Activate" targetRef="End" />
  </bpmn:process>
